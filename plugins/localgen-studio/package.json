{
  "name": "localgen-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LocalGen 姿势 / 服装选择器：侧边栏面板里挑姿势与服装、上传参考图、发起换姿势/换装生成并查看进度。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
